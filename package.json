{
  "name": "dotcrypt",
  "version": "1.0.0",
  "description": "Securely sync multiple .env environments across machines via Git using AES-256-GCM encrypted files.",
  "type": "module",
  "main": "src/crypto.js",
  "bin": {
    "dotcrypt": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "ui/dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "setup": "npm install && npm --prefix ui install && npm run build:ui",
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "prepack": "npm run build:ui"
  },
  "keywords": [
    "dotenv",
    "env",
    "secrets",
    "vault",
    "encryption",
    "aes-256-gcm",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubayerhimel/dotcrypt.git"
  },
  "homepage": "https://github.com/zubayerhimel/dotcrypt#readme",
  "bugs": {
    "url": "https://github.com/zubayerhimel/dotcrypt/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "prompts": "^2.4.2"
  }
}
